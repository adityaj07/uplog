{
  "name": "@uplog/db",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle.config": {
      "types": "./dist/drizzle.config.d.ts",
      "import": "./dist/drizzle.config.js"
    },
    "./index": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/auth": {
      "types": "./dist/schema/auth.d.ts",
      "import": "./dist/schema/auth.js"
    },
    "./schema/changelog": {
      "types": "./dist/schema/changelog.d.ts",
      "import": "./dist/schema/changelog.js"
    },
    "./schema/common": {
      "types": "./dist/schema/common.d.ts",
      "import": "./dist/schema/common.js"
    },
    "./schema/company": {
      "types": "./dist/schema/company.d.ts",
      "import": "./dist/schema/company.js"
    },
    "./schema/contributors": {
      "types": "./dist/schema/contributors.d.ts",
      "import": "./dist/schema/contributors.js"
    },
    "./schema/index": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./schema/invite": {
      "types": "./dist/schema/invite.d.ts",
      "import": "./dist/schema/invite.js"
    },
    "./schema/members": {
      "types": "./dist/schema/members.d.ts",
      "import": "./dist/schema/members.js"
    },
    "./schema/reactions": {
      "types": "./dist/schema/reactions.d.ts",
      "import": "./dist/schema/reactions.js"
    },
    "./schema/relations": {
      "types": "./dist/schema/relations.d.ts",
      "import": "./dist/schema/relations.js"
    },
    "./schema/tags": {
      "types": "./dist/schema/tags.d.ts",
      "import": "./dist/schema/tags.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc && tsx ../../scripts/generate-exports.ts .",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "debug-env": "node scripts/debug-env.js",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push --config=./src/drizzle.config.ts",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio --config=./src/drizzle.config.ts",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate --config=./src/drizzle.config.ts",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate --config=./src/drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.2",
    "nanoid": "^5.1.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.4",
    "@types/pg": "^8.15.4",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.31.2",
    "typescript": "^5.8.2"
  }
}